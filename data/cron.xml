<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <record id="ir_cron_nexi_reconcile" model="ir.cron">
      <field name="name">Nexi: recheck payments left pending</field>
      <field name="model_id" ref="payment.model_payment_transaction"/>
      <field name="state">code</field>
      <field name="code">model._nexi_reconcile_pending()</field>
      <field name="interval_number">10</field>
      <field name="interval_type">minutes</field>
      <field name="nextcall" eval="(DateTime.now() + timedelta(minutes=10)).strftime('%Y-%m-%d %H:%M:%S')"/>
      <field name="active">True</field>
    </record>
  </data>
</odoo>
