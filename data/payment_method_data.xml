  <record id="payment_method_nexi_amex" model="payment.method">
    <field name="name">Amex</field>
    <field name="code">amex</field>
    <field name="active">True</field>
    <field name="primary_payment_method_id" ref="payment_nexi.payment_method_nexi_card"/>
  </record>
