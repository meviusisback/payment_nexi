<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
  <!-- Only the codes the core does not have: card, paypal, mybank, visa,
       mastercard and amex already exist in payment (activated by the hook), so
       _get_from_code does not find two records with the same code. -->
  <record id="payment_method_nexi_googlepay" model="payment.method">
    <field name="name">Google Pay</field>
    <field name="code">googlepay</field>
    <field name="active">True</field>
  </record>
  <record id="payment_method_nexi_applepay" model="payment.method">
    <field name="name">Apple Pay</field>
    <field name="code">applepay</field>
    <field name="active">True</field>
  </record>
  <record id="payment_method_nexi_paypal_bnpl" model="payment.method">
    <field name="name">PayPal Pay in 3</field>
    <field name="code">paypal_bnpl</field>
    <field name="active">True</field>
  </record>
  <record id="payment_method_nexi_bancomatpay" model="payment.method">
    <field name="name">Bancomat Pay</field>
    <field name="code">bancomatpay</field>
    <field name="active">True</field>
  </record>
  </data>
</odoo>
