<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Form di redirect: Odoo lo invia da solo verso Nexi. -->
  <template id="redirect_form" name="Nexi Redirect">
    <form t-att-action="api_url" method="GET">
      <t t-foreach="url_params.items()" t-as="p">
        <input type="hidden" t-att-name="p[0]" t-att-value="p[1]"/>
      </t>
      <p>Stai andando su Nexi… <button type="submit" class="btn btn-primary">Paga su Nexi</button></p>
      <p><a t-att-href="redirect_url">clicca qui se non parte</a></p>
    </form>
  </template>

  <!-- Redirect Build: rimanda alla pagina embed interna. -->
  <template id="redirect_build" name="Nexi Build Redirect">
    <p>Hai scelto pagamento nel sito (Build beta). <a t-att-href="redirect_url">Apri il form di pagamento</a></p>
  </template>

  <!-- Pagina Build v3 beta: iframe Nexi. Serve URL pubblico, localhost non va. -->
  <template id="build_page" name="Nexi Build Page">
    <t t-call="website.layout">
      <div class="container mt-4">
        <h3>Paga con Nexi (Build beta)</h3>
        <p>Build v3 incassa nel sito con iframe Nexi. Se vedi errore, torna a Hosted Page.</p>
        <div id="nexi-build" t-att-data-tx="tx_reference">Carico il form Nexi…</div>
        <p><a href="/shop/payment">Torna alla cassa</a></p>
      </div>
    </t>
  </template>

  <!-- Cassa: preseleziona ultimo metodo + mostra carte salvate Nexi. -->
  <record id="view_payment_form_nexi" model="ir.ui.view">
    <field name="name">payment.form.nexi.saved</field>
    <field name="model" eval="False"/>
    <field name="inherit_id" ref="payment.form"/>
    <field name="arch" type="xml">
      <xpath expr="//t[@t-set='selected_method_id']" position="attributes">
        <attribute name="t-value">not selected_token_id and (request.env['payment.transaction'].sudo().get_last_used_method_id(partner_id, payment_methods_sudo.ids) or (len(payment_methods_sudo) == 1 and payment_methods_sudo[:1].id))</attribute>
      </xpath>
      <xpath expr="//div[@id='o_payment_form_options']/div[1]" position="after">
        <t t-set="nexi_cards" t-value="request.env['payment.transaction'].sudo().get_nexi_saved_cards(partner_id)"/>
        <div t-if="nexi_cards" id="o_payment_nexi_saved" class="d-flex flex-column gap-3">
          <div>
            <h4 class="fs-6 small text-uppercase fw-bolder">Le tue carte salvate</h4>
            <ul class="list-group">
              <t t-foreach="nexi_cards" t-as="nc">
                <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                  <span><i class="fa fa-credit-card"/> <t t-esc="nc['masked']"/></span>
                  <button type="button" class="btn btn-link nexi-use-saved p-0">Usa questa</button>
                </li>
              </t>
            </ul>
            <p class="small text-600 mt-1">Scegli Carta qui sotto: su Nexi la ritrovi già pronta.</p>
          </div>
          <script>
            document.addEventListener('click', function (ev) {
              var b = ev.target.closest('.nexi-use-saved');
              if (!b) return;
              var r = document.querySelector('input[data-payment-method-code="card"]');
              if (r &amp;&amp; !r.checked) r.click();
            });
          </script>
        </div>
      </xpath>
    </field>
  </record>

  <!-- Campi credenziali nel form provider. -->
  <record id="view_provider_nexi" model="ir.ui.view">
    <field name="name">payment.provider.nexi.form</field>
    <field name="model">payment.provider</field>
    <field name="inherit_id" ref="payment.payment_provider_form"/>
    <field name="arch" type="xml">
      <xpath expr="//group[@name='provider_credentials']" position="inside">
        <field name="nexi_api_key" password="True"/>
        <field name="nexi_env"/>
        <field name="nexi_capture"/>
        <field name="nexi_mode"/>
        <field name="nexi_payment_service" placeholder="Vuoto=tutti, es. GOOGLEPAY"/>
        <field name="nexi_oneclick"/>
        <field name="nexi_test_url" placeholder="URL test da developer.nexi.it/it/api/..."/>
        <field name="nexi_prod_url" placeholder="URL produzione da developer.nexi.it/it/api/..."/>
        <button name="button_nexi_check_methods" string="Verifica metodi su Nexi" type="object" class="oe_highlight"/>
        <field name="nexi_methods_checked"/>
        <field name="nexi_methods_report"/>
      </xpath>
    </field>
  </record>
  <!-- Spunta "nascosto" sul form metodo. -->
  <record id="view_payment_method_nexi" model="ir.ui.view">
    <field name="name">payment.method.nexi.form</field>
    <field name="model">payment.method</field>
    <field name="inherit_id" ref="payment.payment_method_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='code']" position="after">
        <field name="nexi_disabled"/>
      </xpath>
    </field>
  </record>
</odoo>
